# Public build configuration; use a separate PostHog project for staging if needed.
VITE_ENV=production
VITE_API_VERSION=v1
VITE_API_URL_DEV=http://localhost:3005/api
VITE_SERVER_URL_DEV=http://localhost:3005
# Web dev uses the Vite /api proxy (vite.config.ts -> VITE_SERVER_URL_DEV).
VITE_API_URL_DEV_WEB=/api
VITE_API_URL_STG=https://staging-api.example.com/api
VITE_SERVER_URL_STG=https://staging-api.example.com
VITE_API_URL_PROD=https://api.example.com/api
VITE_SERVER_URL_PROD=https://api.example.com
# Public PostHog project token, not a personal API key.
VITE_PUBLIC_POSTHOG_KEY=replace-with-public-project-token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
VITE_PUBLIC_POSTHOG_DEFAULTS=2025-05-24
# CI/build only. No VITE_ prefix for private credentials.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
# Optional: hotline displayed on the Settings screen.
# VITE_SUPPORT_HOTLINE=1900 1234
